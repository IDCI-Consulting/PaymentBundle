{% extends '@IDCIPayment/_layout.html.twig' %}

{% block body %}
    <h1>{% trans from 'IDCIPaymentBundle' %}transaction{% endtrans %}</h1>
    <table>
        <tr>
            <th>{% trans from 'IDCIPaymentBundle' %}transaction.number{% endtrans %}</th>
            <td>{% if transaction.number is not null %}{{ transaction.number }}{% else %}N/A{% endif %}</td>
        </tr>
        <tr>
            <th>{% trans from 'IDCIPaymentBundle' %}transaction.payment_gateway_configuration_alias{% endtrans %}</th>
            <td>{{ transaction.paymentGatewayConfigurationAlias }}</td>
        </tr>
        <tr>
            <th>{% trans from 'IDCIPaymentBundle' %}transaction.item_reference{% endtrans %}</th>
            <td>{{ transaction.itemReference }}</td>
        </tr>
        <tr>
            <th>{% trans from 'IDCIPaymentBundle' %}transaction.price{% endtrans %}</th>
            <td>{{ transaction.amount / 100 }} {{ transaction.currencyCode }}</td>
        </tr>
        <tr>
            <th>{% trans from 'IDCIPaymentBundle' %}transaction.customer_reference{% endtrans %}</th>
            <td>{% if transaction.customerReference is not null %}{{ transaction.customerReference }}{% else %}N/A{% endif %}</td>
        </tr>
        <tr>
            <th>{% trans from 'IDCIPaymentBundle' %}transaction.customer_email{% endtrans %}</th>
            <td>{% if transaction.customerEmail is not null %}{{ transaction.customerEmail }}{% else %}N/A{% endif %}</td>
        </tr>
        <tr>
            <th>{% trans from 'IDCIPaymentBundle' %}transaction.description{% endtrans %}</th>
            <td>{% if transaction.description is not null %}{{ transaction.description }}{% else %}N/A{% endif %}</td>
        </tr>
    </table>

    {{ view | raw }}

{% endblock %}
