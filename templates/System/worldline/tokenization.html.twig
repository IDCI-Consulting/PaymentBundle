<div class="worldline-direct-hosted-tokenization">
    <div id="div-hosted-tokenization"></div>
    <button onclick="submitForm()">{% trans from 'IDCIPaymentBundle' %}worldline.pay{% endtrans %}</button>
</div>

<script>
    let tokenizer = null;
    function initTokenizer() {
        tokenizer = new Tokenizer('{{ hosted_tokenization_response.getHostedTokenizationUrl() }}', 'div-hosted-tokenization', { hideCardholderName: false });

        // Invoking tokenizer.initialize() will add the <iframe> inside the previously referenced <div> element
        tokenizer.initialize().then(() => {
            // Do work after initialization, if any
        })
        .catch(reason => {
            // Handle iFrame load error
        });
    }

    function submitForm() {
        tokenizer.submitTokenization().then((result) => {
            if (result.success) {
                let currentUrl = window.location.href;

                if (-1 != currentUrl.indexOf('?') && -1 != currentUrl.indexOf('=')) {
                    extraQuery = '&{{ constant('IDCI\\Bundle\\PaymentBundle\\System\\AbstractPaymentSystem::TRANSACTION_REFERENCE_QUERY_PARAMETER') }}={{ transaction.reference }}&{{ constant('IDCI\\Bundle\\PaymentBundle\\System\\WorldlineDirectPaymentSystem::HOSTED_TOKENIZATION_ID_QUERY_PARAMETER') }}=' + result.hostedTokenizationId;
                } else {
                    extraQuery = '?{{ constant('IDCI\\Bundle\\PaymentBundle\\System\\AbstractPaymentSystem::TRANSACTION_REFERENCE_QUERY_PARAMETER') }}={{ transaction.reference }}&{{ constant('IDCI\\Bundle\\PaymentBundle\\System\\WorldlineDirectPaymentSystem::HOSTED_TOKENIZATION_ID_QUERY_PARAMETER') }}=' + result.hostedTokenizationId;
                }

                window.location.href = currentUrl + extraQuery;
            } else {
                // displayErrorMessage(result.error.message);
            }
        });
    }
</script>
<script src="{{ wordline_host }}/hostedtokenization/js/client/tokenizer.min.js" onload="initTokenizer()"></script>