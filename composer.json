{
    "name": "idci/payment-bundle",
    "type": "symfony-bundle",
    "description": "Symfony payment bundle",
    "keywords": ["symfony", "bundle", "payment"],
    "license": "MIT",
    "authors": [
        {
            "name": "Benjamin Boudier",
            "email": "benjamin.boudier@idci-consulting.fr",
            "homepage": "http://www.idci-consulting.fr"
        },
        {
            "name": "Gabriel Bondaz",
            "email": "gabriel.bondaz@idci-consulting.fr",
            "homepage": "http://www.idci-consulting.fr"
        }
    ],
    "require": {
        "symfony/console": "^6.0|^7.0",
        "symfony/dependency-injection": "^6.0|^7.0",
        "symfony/dom-crawler": "^6.0|^7.0",
        "symfony/framework-bundle": "^6.0|^7.0",
        "symfony/form": "^6.0|^7.0",
        "symfony/intl": "^6.0|^7.0",
        "symfony/templating": "^6.0|^7.0",
        "symfony/twig-bundle": "^6.0|^7.0",
        "symfony/monolog-bundle": "^3.3",
        "symfony/process": "^6.0|^7.0",
        "ramsey/uuid": ">=4.0",
        "ramsey/uuid-doctrine": ">=1.4",
        "doctrine/persistence": "^2.2|^3.0|^4.0",
        "payum/iso4217": "~1.0",
        "jwarkentin/flaky": "~0.0.9",
        "payplug/payplug-php": "^3.0"
    },
    "suggest": {
        "alma/alma-php-client": "^1.0",
        "idci/step-bundle": ">=4.0",
        "paypal/rest-api-sdk-php": "^1.13",
        "payu/apple-pay": "^1.3",
        "stripe/stripe-php": ">=6.7",
        "symfony/cache": "^6.0|^7.0",
        "wl-online-payments-direct/sdk-php": "^8"
    },
    "require-dev": {
        "phpunit/phpunit": ">=9.0"
    },
    "autoload": {
       "psr-4": {
           "IDCI\\Bundle\\PaymentBundle\\": "src/"
       },
       "exclude-from-classmap": [
            "tests/"
        ]
   },
   "minimum-stability": "stable"
}
