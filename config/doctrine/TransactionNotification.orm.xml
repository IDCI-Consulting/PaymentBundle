<?xml version="1.0" encoding="UTF-8" ?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="IDCI\Bundle\PaymentBundle\Entity\TransactionNotification" table="idci_transaction_notification">
        <id name="id" type="string" column="id"></id>
        <field name="callDirection" type="string" column="call_direction" />
        <field name="state" type="string" column="state" />
        <field name="message" type="text" column="message" nullable="true" />
        <field name="metadata" type="json" column="metadata" />
        <field name="createdAt" type="datetime" column="created_at" />

        <many-to-one field="transaction" target-entity="IDCI\Bundle\PaymentBundle\Entity\Transaction" inversed-by="notifications" fetch="EXTRA_LAZY">
            <join-columns>
                <join-column name="transaction_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
            </join-columns>
        </many-to-one>

        <lifecycle-callbacks>
            <lifecycle-callback type="prePersist" method="onPrePersist" />
        </lifecycle-callbacks>
    </entity>
</doctrine-mapping>